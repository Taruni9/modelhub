# ModelCloud Backend Configuration
APP_NAME=ML Model Serving Platform
MAX_FILE_SIZE_MB=100

# Storage Backend: "local" (default) or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Database Configuration (Defaults to persistent local SQLite)
# DATABASE_URL=sqlite:///ml_platform.db

# Optional AWS S3 Configuration (only needed if STORAGE_BACKEND=s3)
# When running on EC2 with an IAM Role, leave ACCESS_KEY and SECRET_KEY blank!
# AWS_S3_BUCKET_NAME=my-modelcloud-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
